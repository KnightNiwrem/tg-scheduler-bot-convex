{
  "name": "tg-scheduler-bot-convex",
  "version": "0.1.0",
  "description": "Telegram bot that schedules one-time and recurring notifications for other Telegram bots. grammY + Convex.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KnightNiwrem/tg-scheduler-bot-convex.git"
  },
  "homepage": "https://github.com/KnightNiwrem/tg-scheduler-bot-convex#readme",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "convex dev",
    "deploy": "convex deploy",
    "set-webhook": "convex run telegram:setWebhook",
    "status": "convex run telegram:status",
    "demo-client": "bun scripts/demo-client.ts",
    "e2e:local": "bun scripts/e2e-local.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p convex && tsc --noEmit",
    "check": "biome check",
    "check:fix": "biome check --write",
    "fallow": "fallow",
    "validate": "bun run check && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@convex-dev/crons": "^0.2.3",
    "convex": "^1.48.0",
    "cron-parser": "^4.9.0",
    "grammy": "^1.46.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "fallow": "^3.37.0",
    "typescript": "^7.0.2"
  }
}
